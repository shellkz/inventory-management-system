# 自己產生, 例如: openssl rand -hex 32。backend 跟 vision-service 要用同一個值
VISION_API_KEY=

FASTSAM_ONNX_PATH=models/FastSAM-s_640_fp32.onnx
DINOV2_ONNX_PATH=models/dinov2_vits14_batch_int8.onnx

VISION_SERVICE_URL=http://vision-service:8000

# go2rtc讀取,組成每台攝影機的RTSP來源URL(rtsp://CAM_USER:CAM_PASS@CAM1_IP:554/CAM_PATH)
# USER/PASS/PATH全部攝影機共用(假設帳密跟型號都一致),只有IP各自不同
CAM_USER=
CAM_PASS=
CAM_PATH=
CAM1_IP=

